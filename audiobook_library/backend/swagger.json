{
  "swagger": "2.0",
  "info": {
    "title": "Audiobook Library API",
    "description": "Audiobook Library CRUD API with Google OAuth Authentication",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": ["http", "https"],

  "securityDefinitions": {
    "cookieAuth": {
      "type": "apiKey",
      "in": "cookie",
      "name": "connect.sid",
      "description": "Session cookie returned after Google OAuth login"
    }
  },

  "paths": {
    "/audiobooks": {
      "get": {
        "description": "Get all audiobooks",
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "description": "Create a new audiobook (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "title",
                "author",
                "listening_length",
                "publisher",
                "narrator",
                "ASIN",
                "audio_release_date",
                "description"
              ],
              "properties": {
                "title": { "type": "string", "example": "Atomic Habits" },
                "author": { "type": "string", "example": "James Clear" },
                "listening_length": {
                  "type": "string",
                  "example": "5 hours 35 minutes"
                },
                "publisher": { "type": "string", "example": "Penguin Audio" },
                "narrator": { "type": "string", "example": "James Clear" },
                "ASIN": { "type": "string", "example": "B07RFSSYBH" },
                "audio_release_date": {
                  "type": "string",
                  "example": "2018-10-16"
                },
                "description": {
                  "type": "string",
                  "example": "An easy & proven way to build good habits and break bad ones."
                }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Audiobook created successfully" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },

    "/audiobooks/{id}": {
      "get": {
        "description": "Get audiobook by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Audiobook not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update audiobook by ID (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/paths/~1audiobooks/post/parameters/0/schema"
            }
          }
        ],
        "responses": {
          "200": { "description": "Audiobook updated successfully" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Audiobook not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete audiobook by ID (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Audiobook deleted successfully" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Audiobook not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },

    "/users": {
      "get": {
        "description": "Get all users (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "description": "Create a new user (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "googleId": { "type": "string" },
                "displayName": { "type": "string" },
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "email": { "type": "string" },
                "date": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "User already exists" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },

    "/users/{id}": {
      "get": {
        "description": "Get user by ID (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "User not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update user by ID (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "User updated successfully" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "User not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete user by ID (Authentication required)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "User deleted successfully" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "User not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },

    "/auth/google": {
      "get": {
        "description": "Authenticate using Google OAuth",
        "responses": {
          "302": { "description": "Redirect to Google login page" }
        }
      }
    },

    "/auth/google/callback": {
      "get": {
        "description": "Google OAuth callback endpoint",
        "responses": {
          "302": { "description": "Redirect after successful or failed login" }
        }
      }
    },

    "/auth/me": {
      "get": {
        "description": "Get current authenticated user",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Returns logged in user" },
          "401": { "description": "Unauthorized" }
        }
      }
    },

    "/auth/logout": {
      "get": {
        "description": "Logout current user",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "302": { "description": "Redirect to home page" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}
